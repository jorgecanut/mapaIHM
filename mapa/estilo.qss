/* ------------------------------------------------ */
/* ESTILO GLOBAL y VENTANA PRINCIPAL                */
/* ------------------------------------------------ */

* {
    /* Fuente base ligeramente más pequeña para evitar recortes en Linedit */
    font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #E0E0E0; /* Texto gris claro por defecto */
}

QMainWindow, QWidget#LoginRegister, QWidget#centralwidget, QStackedWidget {
    background-color: #2D2D30; /* Fondo gris oscuro uniforme */
}

/* ------------------------------------------------ */
/* ENCABEZADOS Y TÍTULOS (label_11 = Login, label_7 = Register) */
/* ------------------------------------------------ */

QLabel#label_11, QLabel#label_7 {
    font-size: 22px;
    font-weight: bold;
    color: #00A9FF; /* Color de acento azul */

    /* Aumento del padding para evitar que el texto grande se corte (SOLUCIÓN AL ÚLTIMO PROBLEMA) */
    padding-top: 15px;
    padding-bottom: 25px;
    min-height: 40px;
}

/* Etiquetas de campo (Usuario, Contraseña, etc.) */
QLabel {
    color: #F5F5F5;
    margin-top: 5px;
    margin-bottom: 3px;
}

/* Etiquetas de Error (lErrorUsuario_IS, lErrorEmail, etc.) */
QLabel[styleSheet*="color:red"] {
    color: #FF6B6B; /* Rojo vibrante */
    font-size: 12px;
}

/* ------------------------------------------------ */
/* CONTROLES DE ENTRADA (QLineEdit)                 */
/* ------------------------------------------------ */

QLineEdit {
    background-color: #3C3C3F;
    border: 1px solid #505055;
    border-radius: 5px;
    /* Padding reducido y simétrico para evitar que el texto se corte (SOLUCIÓN A TEXTO CORTADO) */
    padding: 6px 8px;
    min-height: 20px;
    color: #F0F0F0;
}

QLineEdit:focus {
    border: 1px solid #00A9FF;
    background-color: #454548;
}

/* ------------------------------------------------ */
/* BOTONES DE ACCIÓN (QPushButton)                  */
/* ------------------------------------------------ */

/* pbInicioSesion (Login) y pushButton (CONFIRMAR/Registro) */
QPushButton#pbInicioSesion, QPushButton#pbConfirmar {
    background-color: #00A9FF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 25px;
    font-size: 15px;
    font-weight: bold;
    /* Tamaños ajustados para evitar desbordes */
    min-width: 140px;
    min-height: 40px;
    max-height: 45px;
    margin-top: 20px;
    margin-bottom: 10px;
}

QPushButton#pbInicioSesion:hover {
    background-color: #007ACC;
}
QPushButton#pbConfirmar:hover {
    background-color: #007ACC;
}

QPushButton#pbInicioSesion:pressed {
    background-color: #005A99;
}
QPushButton#pbConfirmar:pressed {
    background-color: #005A99;
}
QPushButton#pbConfirmar:disabled {
    background-color: #505055;
    color: #A0A0A0;
}
QPushButton#pbInicioSesion:disabled{
background-color: #505055;
color: #A0A0A0;
}
/* ------------------------------------------------ */
/* CHECKBOXES (checkBox, checkBox_2, etc.)          */
/* ------------------------------------------------ */

QCheckBox {
    color: #C0C0C0;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #808080;
    background-color: #4A4A4D;
}

QCheckBox::indicator:checked {
    background-color: #4EC9B0; /* Turquesa para check */
    border: 1px solid #4EC9B0;
}

/* ------------------------------------------------ */
/* ENLACES (ClickableLabel)                         */
/* ------------------------------------------------ */

/* label_10 (¿No tienes cuenta?) y label_3 (¿Ya tienes cuenta?) */
ClickableLabel {
    color: #4EC9B0;
    text-decoration: none;
    font-weight: bold;
}

ClickableLabel:hover {
    color: #00A9FF;
}

/* ------------------------------------------------ */
/* DATE EDIT y COMBO BOX (Registro)                 */
/* ------------------------------------------------ */

QDateEdit, QComboBox {
    background-color: #3C3C3F;
    border: 1px solid #505055;
    border-radius: 5px;
    padding: 4px;
    min-height: 25px;
}

QDateEdit::drop-down, QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #505055;
    border-left-style: solid;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
/* ------------------------------------------------ */
/* ESTILO GLOBAL y VENTANA PRINCIPAL                */
/* ------------------------------------------------ */

* {
    /* Fuente base: Segoe UI es común en Windows, asegura compatibilidad */
    font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #E0E0E0; /* Texto gris claro por defecto */
}

/* Aplicado a ambas ventanas (LoginRegister y Perfil) */
QMainWindow, QWidget#LoginRegister, QWidget#Perfil, QWidget#centralwidget, QStackedWidget {
    background-color: #2D2D30; /* Fondo gris oscuro uniforme */
}

QLabel#lAvatar {

    border-radius: 50px;

}
/* ------------------------------------------------ */
/* ENCABEZADOS Y TÍTULOS */
/* ------------------------------------------------ */

/* Títulos principales (Login, Register, Perfil) */
QLabel#label_11, QLabel#label_7, QLabel#label {
    font-size: 22px;
    font-weight: bold;
    color: #00A9FF; /* Color de acento azul */

    /* Padding generoso para asegurar que el título grande no se corte */
    padding-top: 15px;
    padding-bottom: 25px;
    min-height: 40px;
}

/* Etiquetas de campo (Usuario, Contraseña, Correo, etc.) */
QLabel {
    color: #F5F5F5;
    margin-top: 5px;
    margin-bottom: 3px;
    /* Asegura un espacio mínimo para la altura de la fuente (corrección de recorte) */
    min-height: 18px;
}

/* Etiquetas de Error */
QLabel[styleSheet*="color:red"], QLabel#lErrorContrasea, QLabel#lErrorCorreo, QLabel#lErrorFecha {
    color: #FF6B6B; /* Rojo vibrante */
    font-size: 12px;
}

/* ------------------------------------------------ */
/* CONTROLES DE ENTRADA (QLineEdit)                 */
/* ------------------------------------------------ */

QLineEdit {
    background-color: #3C3C3F;
    border: 1px solid #505055;
    border-radius: 5px;
    /* Padding balanceado y min-height ajustado (corrección de recorte) */
    padding: 5px 8px;
    min-height: 25px;
    color: #F0F0F0;
}

QLineEdit:focus {
    border: 1px solid #00A9FF;
    background-color: #454548;
}

/* Estilo para campos de solo lectura (como el nombre de usuario en Perfil) */
QLineEdit[readOnly="true"] {
    background-color: #333336;
    color: #A0A0A0;
    border: 1px solid #454548;
}

/* ------------------------------------------------ */
/* BOTONES DE ACCIÓN (QPushButton)                  */
/* ------------------------------------------------ */

/* Estilo unificado para todos los botones principales de acción */
QPushButton#pbConfirmarCambios {
    background-color: #00A9FF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 25px;
    font-size: 15px;
    font-weight: bold;
    /* Tamaños ajustados para asegurar visibilidad */
    min-width: 140px;
    max-height: 45px;
    margin-top: 20px;
    margin-bottom: 10px;
}

QPushButton#pbConfirmarCambios:hover {
    background-color: #007ACC;
}

QPushButton#pbConfirmarCambios:pressed {
    background-color: #005A99;
}

/* Botón deshabilitado */
QPushButton#pbConfirmarCambios:disabled {
    background-color: #505055;
    color: #A0A0A0;
}
QPushButton#pbCambiarAvatar {
    /* Tamaño de botón 40px -> Radio 20px */
    border-radius: 20px;

    /* Fondo blanco */
    background-color: white;

    /* Opcional: Sombra para efecto elevado */
    border: none;
    padding: 5px;
}
/* ------------------------------------------------ */
/* CHECKBOXES (QCheckBox)                          */
/* ------------------------------------------------ */

QCheckBox {
    color: #C0C0C0;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #808080;
    background-color: #4A4A4D;
}

QCheckBox::indicator:checked {
    background-color: #4EC9B0; /* Turquesa */
    border: 1px solid #4EC9B0;
}

/* ------------------------------------------------ */
/* ENLACES (ClickableLabel)                         */
/* ------------------------------------------------ */

ClickableLabel {
    color: #4EC9B0;
    text-decoration: none;
    font-weight: bold;
}

ClickableLabel:hover {
    color: #00A9FF;
}

/* ------------------------------------------------ */
/* DATE EDIT y COMBO BOX (QDateEdit, QComboBox)     */
/* ------------------------------------------------ */

QDateEdit, QComboBox {
    background-color: #3C3C3F;
    border: 1px solid #505055;
    border-radius: 5px;
    padding: 4px;
    min-height: 25px;
    color: #F0F0F0;
}

QDateEdit::drop-down, QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 1px;
    border-left-color: #505055;
    border-left-style: solid;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* ------------------------------------------------ */
/* Preguntas                                        */
/* ------------------------------------------------ */


QWidget#dockWidgetContents {
    background: #609DBD;
    color : #3B3D3D;
}

QDockWidget::title{
    background-color : #609dbd;
    color: #1f2424;
}


QPushButton#pbTogglePreguntas {
    background-color: #BFD6E4;
    border: 1px solid #7A8C96;
    border-radius: 6px;
    font-weight: bold;
}

QPushButton#pbTogglePreguntas:hover {
    background-color: #D7E6EF;
}

/* =========================
   ÍNDICE (Pregunta X / Y)
   ========================= */
QLabel#lIndice {
    font-size: 15px;
    font-weight: bold;
    color: #1F2424;
}

/* =========================
   TEXTO DE LA PREGUNTA
   ========================= */
QLabel#lPregunta {
    font-size: 11px;
    font-weight: 600;
    color: #1f2424;
    border: 1px solid #000000;
    border-radius : 10px;
    padding : 10px;

}

/* =========================
   RESPUESTAS (RADIOS)
   ========================= */
QRadioButton {
    padding: 8px;
    border-radius: 10px;
    background-color: #C7DCE8;
    border: 1px solid #8FA5B1;
    color: #1f2424;
}

QRadioButton:hover {
    background-color: #DCEAF2;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QRadioButton::indicator:unchecked {
    border: 2px solid #4a4f4f;
    border-radius: 7px;
    background: transparent;
}

QRadioButton::indicator:checked {
    border: 2px solid #1f2424;
    border-radius: 7px;
    background: #1f2424;
}

/* Respuestas bloqueadas tras comprobar */
QRadioButton:disabled {
    color: #7a8c96;
    background-color: #bfd6e4;
}

/* =========================
   BOTÓN CONFIRMAR
   ========================= */
QPushButton#pbResolverPreguntas {
    background: #E9F2F6;
    color: #1f2424;
    border: 1px solid #8fa5b1;
    border-radius: 12px;
    padding: 10px;
    font-weight: 800;
}

QPushButton#pbResolverPreguntas:hover {
    background: #FFFFFF;
}

QPushButton#pbResolverPreguntas:disabled {
    background-color: #c7dce8;
    color: #7a8c96;
}

/* =========================
   BOTONES DE NAVEGACIÓN
   ========================= */
QPushButton#pbAnterior,
QPushButton#pbRandom,
QPushButton#pbSiguiente {
    background-color: #c7dce8;
    border: 1px solid #8fa5b1;
    border-radius: 10px;
    padding: 6px;
    font-weight: 600;
    color: #1f2424;
}

QPushButton#pbAnterior:hover,
QPushButton#pbRandom:hover,
QPushButton#pbSiguiente:hover {
    background-color: #DCEAF2;
}
QPushButton#pbAvatarElegir {
    /* Tamaño de botón 40px -> Radio 20px */
    border-radius: 20px;

    /* Fondo blanco */
    background-color: white;

    /* Opcional: Sombra para efecto elevado */
    border: none;
    padding: 5px;
}
QToolBar QToolButton:hover {
    background-color: rgba(220, 234, 242, 0.5);
}
QToolBar {
    background-color: #F8FBFE; /* Un azul casi blanco, muy profesional */
    border-bottom: 1px solid #DCEAF2; /* Una línea fina debajo para separar */
    spacing: 10px; /* Espacio entre los iconos */
    padding: 5px;
}
/* ------------------------------------------------ */
/* VENTANA DE ESTADÍSTICAS (stats)                  */
/* ------------------------------------------------ */

/* Título principal: "Estadísticas" */
QLabel#label_titulo {
    font-size: 24px;
    font-weight: bold;
    color: #00A9FF; /* Azul de acento */
    padding-top: 10px;
    padding-bottom: 15px;
}

/* Etiquetas de fecha (Actualizado a tus nuevos IDs) */
QLabel#labelInicio, QLabel#labelFinal {
    font-weight: bold;
    color: #F5F5F5; /* Blanco para legibilidad */
    font-size: 13px;
    margin-right: 5px;
}

/* El contenedor del selector de fecha */
QDateEdit {
    background-color: #3C3C3F;
    border: 1px solid #505055;
    border-radius: 5px;
    padding-left: 5px;
    color: #F0F0F0;
}

/* El botón de la derecha */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px; /* Un poco más ancho para que luzca el icono */
    border-left: 1px solid #505055;
    background-color: #454548;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* AQUÍ AÑADES TU ICONO */
QDateEdit::down-arrow {
    image: url(:/icons/icons/calendario.png); /* Ruta a tu recurso o archivo */
    width: 16px;  /* Ajusta el tamaño según tu imagen */
    height: 16px;
}

/* Efecto hover para que el usuario sepa que puede clicar */
QDateEdit::drop-down:hover {
    background-color: #00A9FF;
}
/* ------------------------------------------------ */
/* BOTÓN VOLVER (btnVolver)                         */
/* ------------------------------------------------ */

QPushButton#btnVolver {
    background-color: #454548; /* Gris un poco más claro que el fondo */
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 25px;
    font-size: 14px;
    font-weight: bold;
    min-width: 120px;
    min-height: 35px;
    margin-top: 10px;
}

/* Al pasar el ratón, se vuelve azul como tus botones principales */
QPushButton#btnVolver:hover {
    background-color: #00A9FF;
}

QPushButton#btnVolver:pressed {
    background-color: #005A99;
}

/* ------------------------------------------------ */
/* TABLA DE RESULTADOS                              */
/* ------------------------------------------------ */

QTableWidget {
    background-color: #252526;
    border: 1px solid #3F3F46;
    gridline-color: #333333;
    border-radius: 8px;
    alternate-background-color: #2D2D30; /* Filas alternas para mejor lectura */
}

QHeaderView::section {
    background-color: #333337;
    color: #00A9FF;
    font-weight: bold;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #00A9FF; /* Línea azul bajo el encabezado */
}

QTableWidget::item {
    padding: 10px;
}

/* Estilo para cuando seleccionas una fila */
QTableWidget::item:selected {
    background-color: rgba(0, 169, 255, 0.2); /* Fondo azul transparente */
    color: #FFFFFF;
    border: 1px solid #00A9FF;
}

/* Panel Principal */
QWidget#panelLapiz {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

/* Panel de Texto */
QWidget#panelTexto {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 4px;
}

/* Labels */
QLabel#lcolor, QLabel#lGrosor, QLabel#label_3, QLabel#label_4, QLabel#label_5,  QLabel#ltamanolinea {
    color: #333333;
    font-size: 12pt;
    background-color: transparent;
    font-weight: bold;

}

/* ComboBox */
QComboBox#fontSize {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 5px;
    color: #333333;
    min-height: 25px;
}

QComboBox#fontSize:hover {
    border: 1px solid #999999;
}

QComboBox#fontSize::drop-down {
    border: none;
    width: 20px;
}

QComboBox#fontSize QAbstractItemView {
    background-color: white;
    color: #333333;
    selection-background-color: #4a90e2;
    selection-color: white;
}


/* FontComboBox */
QFontComboBox#fontType {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    border-radius: 3px;
    padding: 5px;
    color: #333333;
    min-height: 25px;
}

QFontComboBox#fontType:hover {
    border: 1px solid #999999;
}

QFontComboBox#fontType::drop-down {
    border: none;
    width: 20px;
}

QFontComboBox#fontType QAbstractItemView {
    background-color: white;
    color: #333333;
    selection-background-color: #4a90e2;
    selection-color: white;
}


/* QPushButton - Botón de Color */
QPushButton#botonColor2 {
    background-color: #4a90e2;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton#botonColor2:hover {
    background-color: #357abd;
}

QPushButton#botonColor2:pressed {
    background-color: #2868a8;
}


/* QPushButton - Cambiar Color */
QPushButton#cambiarColor {
    background-color: #4a90e2;
    color: white;
    border: none;
    border-radius: 3px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton#cambiarColor:hover {
    background-color: #357abd;
}

QPushButton#cambiarColor:pressed {
    background-color: #2868a8;
}

/* QSlider */
QSlider::groove:horizontal {
    border: 1px solid #cccccc;
    height: 6px;
    background: #f5f5f5;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #4a90e2;
    border: 1px solid #357abd;
    width: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #357abd;
}

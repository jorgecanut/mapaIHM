mapa.app/Contents/PkgInfo: 
	@test -d mapa.app/Contents || mkdir -p mapa.app/Contents
	@$(DEL_FILE) mapa.app/Contents/PkgInfo
	@echo "APPL????" > mapa.app/Contents/PkgInfo
mapa.app/Contents/Info.plist: 
	@test -d mapa.app/Contents || mkdir -p mapa.app/Contents
	@$(DEL_FILE) mapa.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - /Users/marc/Qt/6.9.2/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.mapa,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.mapa,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,mapa,g" -e "s,@LIBRARY@,mapa,g" -e "s,\$${EXECUTABLE_NAME},mapa,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >mapa.app/Contents/Info.plist


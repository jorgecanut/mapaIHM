####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/mapa/bin || mkdir -p $(INSTALL_ROOT)/opt/mapa/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/mapa/bin/mapa.app
	
	$(QINSTALL) mapa.app $(INSTALL_ROOT)/opt/mapa/bin/mapa.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/mapa/bin/mapa.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/mapa/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

